  bool _editMode = false;
  late List<List<String>> _editBoard; // 8x8: 'K','q','.' ...
  ch.Color _editTurn = ch.Color.WHITE;
  bool _castleK = true, _castleQ = true, _castlek = true, _castleq = true;

  // техническая переменная: откуда тянем фигуру (например 'e2'), null = с палитры
  String? _dragFromSquare;

  // ---- утилиты редактора ----
  int _rankIndex(String sq) => 8 - int.parse(sq[1]); // 0..7 сверху вниз
  int _fileIndex(String sq) => sq.codeUnitAt(0) - 'a'.codeUnitAt(0); // 0..7

  String _unicodeForFen(String f) {
    switch (f) {
      case 'K': return '♔';
      case 'Q': return '♕';
      case 'R': return '♖';
      case 'B': return '♗';
      case 'N': return '♘';
      case 'P': return '♙';
      case 'k': return '♚';
      case 'q': return '♛';
      case 'r': return '♜';
      case 'b': return '♝';
      case 'n': return '♞';
      case 'p': return '♟';
      default: return '';
    }
  }

  String? _pieceCodeFromFen(String f) {
    switch (f) {
      case 'K': return 'wK';
      case 'Q': return 'wQ';
      case 'R': return 'wR';
      case 'B': return 'wB';
      case 'N': return 'wN';
      case 'P': return 'wP';
      case 'k': return 'bK';
      case 'q': return 'bQ';
      case 'r': return 'bR';
      case 'b': return 'bB';
      case 'n': return 'bN';
      case 'p': return 'bP';
      default: return null;
    }
  }

  String _fenFromPieceCode(String code) {
    switch (code) {
      case 'wK': return 'K';
      case 'wQ': return 'Q';
      case 'wR': return 'R';
      case 'wB': return 'B';
      case 'wN': return 'N';
      case 'wP': return 'P';
      case 'bK': return 'k';
      case 'bQ': return 'q';
      case 'bR': return 'r';
      case 'bB': return 'b';
      case 'bN': return 'n';
      case 'bP': return 'p';
      default: return '.';
    }
  }

  List<List<String>> _fenToBoard(String fen) {
    final parts = fen.split(' ');
    final board = List.generate(8, (_) => List.filled(8, '.'));
    final rows = parts[0].split('/');
    for (int r = 0; r < 8; r++) {
      int c = 0;
      for (final chh in rows[r].split('')) {
        if (int.tryParse(chh) != null) {
          c += int.parse(chh);
        } else {
          board[r][c++] = chh;
        }
      }
    }
    return board;
  }

  String _boardToFen() {
    final sb = StringBuffer();
    for (int r = 0; r < 8; r++) {
      int empty = 0;
      for (int c = 0; c < 8; c++) {
        final f = _editBoard[r][c];
        if (f == '.') {
          empty++;
        } else {
          if (empty > 0) {
            sb.write(empty);
            empty = 0;
          }
          sb.write(f);
        }
      }
      if (empty > 0) sb.write(empty);
      if (r != 7) sb.write('/');
    }
    // ход
    final turn = _editTurn == ch.Color.WHITE ? 'w' : 'b';
    // рокировки
    final castle = [
      if (_castleK) 'K',
      if (_castleQ) 'Q',
      if (_castlek) 'k',
      if (_castleq) 'q',
    ].join();
    final castleStr = castle.isEmpty ? '-' : castle;
    return '${sb.toString()} $turn $castleStr - 0 1';
  }

