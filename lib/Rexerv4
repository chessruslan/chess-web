  // ================== BUILD (адаптив) ==================
  @override
  Widget build(BuildContext context) {
    final media = MediaQuery.of(context);
    final w = media.size.width;
    final h = media.size.height;
    final bool isMobile = w < 900;

    final double desired = _baseAt100 * (_boardPercent / 100.0);
    final double sizeLimit = (isMobile ? w : math.min(w, h)) - 32;
    final double boardSize = desired.clamp(120.0, sizeLimit);

    final isLogged = Supabase.instance.client.auth.currentUser != null;

    return SafeArea(
      child: Scaffold(
        appBar: AppBar(
          title: Text(widget.title),
          actions: [
            if (_inRoom)
              Padding(
                padding: const EdgeInsets.only(right: 12),
                child: Chip(
                  avatar: const Icon(Icons.sports_esports, size: 18),
                  label: Text('Комната: ${_opponentName ?? 'opponent'}'),
                ),
              ),
            IconButton(
              tooltip: 'Новая игра',
              onPressed: _startFreshGame,
              icon: const Icon(Icons.fiber_new),
            ),
            if (!isMobile)
              Row(
                children: [
                  IconButton(
                    tooltip: 'Уменьшить (-10%)',
                    onPressed: () => _changeBoardPercent(-_stepPercent),
                    icon: const Icon(Icons.remove),
                  ),
                  Text('${_boardPercent.toStringAsFixed(0)}%'),
                  IconButton(
                    tooltip: 'Увеличить (+10%)',
                    onPressed: () => _changeBoardPercent(_stepPercent),
                    icon: const Icon(Icons.add),
                  ),
                  PopupMenuButton<double>(
                    tooltip: 'Выбрать масштаб',
                    onSelected: (value) => _setBoardPercent(value),
                    itemBuilder: (context) => const [
                      PopupMenuItem(value: 60, child: Text('60%')),
                      PopupMenuItem(value: 80, child: Text('80%')),
                      PopupMenuItem(value: 100, child: Text('100%')),
                      PopupMenuItem(value: 120, child: Text('120%')),
                      PopupMenuItem(value: 140, child: Text('140%')),
                    ],
                  ),
                  OutlinedButton(
                      onPressed: _resetBoardPercent, child: const Text('100%')),
                ],
              ),
            Padding(
              padding: const EdgeInsets.only(right: 12),
              child: _AuthButton(
                nickname: _nickname,
                isLoggedIn: isLogged,
                onTap: () => setState(() => _authOpen = !_authOpen),
                onLogout: () async {
                  await Supabase.instance.client.auth.signOut();
                  await _leaveRoom();
                  await _leaveLobby();
                  setState(() {
                    _authOpen = false;
                    _nickname = null;
                  });
                },
              ),
            ),
          ],
        ),
        body: isMobile
            ? _buildMobileBody(boardSize, isLogged)
            : _buildDesktopBody(boardSize, isLogged),
        resizeToAvoidBottomInset: true,
      ),
    );
  }

