      );
    }
  }

  Future<void> _openRoom(
    String roomId, {
    required String opponentId,
    required String opponentName,
    required String myColor,
  }) async {
    _room?.disconnect();
    final supa = Supabase.instance.client;
    final room = RoomService(supa, roomId: roomId)
      ..onMove = (m) {
        _applyRemoteMove(
            '${m['from']}', '${m['to']}', m['promotion']?.toString());
      }
      ..onResult = (res) async {
        await _finalizeOnlineResult(res);
      }
      ..onDrawOffer = () async {
        final ok = await showDialog<bool>(
          context: context,
          builder: (_) => AlertDialog(
            title: const Text('Предложение ничьей'),
            content: Text('$_opponentName предлагает ничью. Принять?'),
            actions: [
              TextButton(
                  onPressed: () => Navigator.pop(context, false),
                  child: const Text('Отклонить')),
              FilledButton(
                  onPressed: () => Navigator.pop(context, true),
                  child: const Text('Принять')),
            ],
          ),
        );
        await _room?.sendDrawAnswer(ok == true);
        if (ok == true) {
          await _room?.sendResult('draw');
          await _finalizeOnlineResult('draw');
          _showGameOverDialog('Ничья', 'Партия окончена по соглашению сторон.');
        } else {
          if (mounted) {
            ScaffoldMessenger.of(context).showSnackBar(
              const SnackBar(content: Text('Ничья отклонена')),
            );
          }
        }
      }
      ..onDrawAnswer = (accepted) {
        if (accepted) {
          _finalizeOnlineResult('draw');
          _showGameOverDialog('Ничья', 'Партия окончена по соглашению сторон.');
        } else {
          if (mounted) {
            ScaffoldMessenger.of(context).showSnackBar(
              const SnackBar(content: Text('Соперник отклонил ничью')),
            );
          }
        }
      }
      ..onResign = () {
        final winner = _humanColor == ch.Color.WHITE ? 'white' : 'black';
        _finalizeOnlineResult(winner);
        _showGameOverDialog('Соперник сдался',
            '${_humanColor == ch.Color.WHITE ? "Белые" : "Чёрные"} победили (сдача соперника).');
      };

    await room.connect();
    setState(() {
      _room = room;
      _roomId = roomId;
      _opponentId = opponentId;
      _opponentName = opponentName;
      _vsEngine = false;
      _engineThinking = false;
      _humanColor =
          (myColor.toLowerCase() == 'white') ? ch.Color.WHITE : ch.Color.BLACK;
      _resultSent = false;
      _opponentRating = null;
    });

    // Попробуем взять рейтинг соперника из лобби
    final peer = _lobby?.online
        .firstWhere((e) => e['id'] == opponentId, orElse: () => {});
    if (peer != null && peer.isNotEmpty) {
      setState(() => _opponentRating =
          int.tryParse(peer['rating'] ?? '') ?? _opponentRating);
    }

    // Сброс партии
    game.reset();
    _fenController.text = game.fen;
    _sanMoves.clear();
    _fens
      ..clear()
      ..add(game.fen);
    _plyIndex = 0;

    if (mounted) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
            content: Text(
                'Игра против $_opponentName (${myColor == 'white' ? 'белыми' : 'чёрными'})')),
      );
    }
  }

  Future<void> _leaveRoom() async {
    await _room?.disconnect();
    setState(() {
      _room = null;
      _roomId = null;
      _opponentId = null;
      _opponentName = null;
      _resultSent = false;
    });
  }

