// ------------------ одноразовый снос старого SW и кэшей ------------------
Future<void> _killServiceWorkerOnce() async {
  if (!kIsWeb) return;
  try {
    final ls = html.window.localStorage;
    if (ls['sw_fix_done'] == '1') return;

    final sw = html.window.navigator.serviceWorker;
    if (sw != null) {
      final regs = await sw.getRegistrations();
      for (final r in regs) {
        try {
          await r.unregister();
        } catch (_) {}
      }
    }
    final caches = html.window.caches;
    if (caches != null) {
      final keys = await caches.keys();
      for (final k in keys) {
        try {
          await caches.delete(k);
        } catch (_) {}
      }
    }
    ls['sw_fix_done'] = '1';
    html.window.location.reload();
  } catch (_) {}
}

