  void _checkGameOver() {
    if (game.in_checkmate) {
      final winner = game.turn == ch.Color.WHITE ? "Чёрные" : "Белые";
      _showGameOverDialog("Мат", "$winner победили!");
      if (_inRoom) {
        // сейчас ход цвета, которому поставили мат
        final res = (game.turn == ch.Color.WHITE) ? 'black' : 'white';
        _room?.sendResult(res);
        _finalizeOnlineResult(res);
      }
      return;
    }
    if (game.in_stalemate) {
      _showGameOverDialog("Пат", "Ничья — патовое положение");
      if (_inRoom) {
        _room?.sendResult('draw');
        _finalizeOnlineResult('draw');
      }
      return;
    }
    if (game.in_threefold_repetition) {
      _showGameOverDialog("Ничья", "Ничья — троекратное повторение позиции");
      if (_inRoom) {
        _room?.sendResult('draw');
        _finalizeOnlineResult('draw');
      }
      return;
    }
    if (game.in_draw) {
      _showGameOverDialog("Ничья", "Игра окончена вничью");
      if (_inRoom) {
        _room?.sendResult('draw');
        _finalizeOnlineResult('draw');
      }
      return;
    }
  }

