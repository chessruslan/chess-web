// ---------- Одноразовое удаление старого Service Worker и кэшей ----------
Future<void> _killServiceWorkerOnce() async {
  if (!kIsWeb) return;
  try {
    final ls = html.window.localStorage;
    if (ls['sw_fix_done'] == '1') return;

    final sw = html.window.navigator.serviceWorker;
    if (sw != null) {
      final regs = await sw.getRegistrations();
      for (final r in regs) {
        try {
          await r.unregister();
        } catch (_) {}
      }
    }

    final cacheStorage = html.window.caches;
    if (cacheStorage != null) {
      final keys = await cacheStorage.keys();
      for (final k in keys) {
        try {
          await cacheStorage.delete(k);
        } catch (_) {}
      }
    }

    ls['sw_fix_done'] = '1';
    html.window.location.reload();
  } catch (_) {}
}

// ------------------------------ APP ------------------------------
Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  await Supabase.initialize(url: supabaseUrl, anonKey: supabaseAnonKey);
  await _killServiceWorkerOnce();
  runApp(const MyApp());
}

